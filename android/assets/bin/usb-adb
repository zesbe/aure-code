#!/usr/bin/env python3
"""usb-adb — memakai adb untuk perangkat Android lain yang tersambung lewat kabel OTG.

  usb-adb                  beri izin dan ambil alih satu-satunya perangkat dengan debugging USB aktif, lalu jalankan layanan adb
  usb-adb --name /dev/bus/usb/003/004   pilih perangkat tertentu
  usb-adb list             daftar perangkat USB (JSON)

Proses biasa tidak bisa membuka /dev/bus/usb, jadi harus diberi izin lewat UsbManager sistem (akan muncul dialog, ketuk "OK").
Setelah Aure Code mendapatkan perangkatnya, fd-nya diteruskan ke sini dan layanan adb dijalankan dengan TERMUX_USB_FD; setelah itu pakai adb devices / install / shell seperti biasa.
Satu perangkat setiap kali; jalankan ulang setelah kabel dicabut-pasang. Pada sambungan pertama, perangkat yang diuji juga perlu mengetuk "Izinkan debugging USB".
"""
import json, os, socket, subprocess, sys

# 私有目录里的文件套接字：别的应用抢不走（以前的抽象套接字谁都能先绑 —— 审查 H2）
SOCK = os.environ.get("CCAPP_PRIV_SOCK") or "/data/data/cc.codtest/files/.priv.sock"


def call(req, want_fd=False):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError as e:
        sys.exit(f"usb-adb: tidak bisa tersambung ke Aure Code ({e}) — hanya bisa dipakai di terminal Aure Code")
    s.sendall((json.dumps(req) + "\n").encode())
    buf, fds = b"", []
    while not buf.endswith(b"\n"):
        if want_fd:
            data, got, _, _ = socket.recv_fds(s, 65536, 1)
            fds += got
        else:
            data = s.recv(65536)
        if not data:
            break
        buf += data
    s.close()
    return (json.loads(buf) if buf else {"ok": False, "message": "Aure Code tidak membalas"}), fds


def main(argv):
    if argv[:1] == ["list"]:
        r, _ = call({"op": "usb_list"})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return 0 if r.get("ok") else 1
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    i = argv.index("--name") if "--name" in argv else -1
    if i >= 0 and i + 1 >= len(argv):
        print("usb-adb: --name harus diikuti nama perangkat", file=sys.stderr)
        return 2
    name = argv[i + 1] if i >= 0 else ""
    print("usb-adb: meminta izin USB (ketuk \"OK\" di dialog sistem yang muncul)…", file=sys.stderr)
    r, fds = call({"op": "usb_open", "name": name, "timeout": 90}, want_fd=True)
    if not r.get("ok") or not fds:
        for f in fds:
            os.close(f)
        sys.exit("usb-adb: " + r.get("message", "fd perangkat tidak didapat"))
    fd = fds[0]
    os.set_inheritable(fd, True)
    print(f"usb-adb: mengambil alih {r.get('manufacturer')} {r.get('product')} ({r.get('name')})", file=sys.stderr)
    # adb 服务只在启动时读一次 TERMUX_USB_FD，所以先停掉旧服务
    subprocess.run(["adb", "kill-server"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    env = dict(os.environ, TERMUX_USB_FD=str(fd))
    # adb 只把 "localhost" 认作本机：服务地址写成 tcp:127.0.0.1:端口 时 start-server 会报
    # "cannot start server on remote host"。起服务这一下统一换成 localhost（客户端连 127.0.0.1 不受影响）
    spec = env.get("ADB_SERVER_SOCKET", "")
    if spec.startswith(("tcp:127.0.0.1:", "tcp:[::1]:")):
        env["ADB_SERVER_SOCKET"] = "tcp:localhost:" + spec.rsplit(":", 1)[1]
    rc = subprocess.run(["adb", "start-server"], env=env, pass_fds=(fd,)).returncode
    os.close(fd)
    if rc == 0:
        import time; time.sleep(1)   # 服务刚起，给 libusb 一点时间认设备
        subprocess.run(["adb", "devices", "-l"])
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
